# .env.example — copy to .env and fill in. Never commit .env.
# --- Always required ---
SEC_USER_AGENT="Your Name your.email@example.com"  # REQUIRED: sent on every SEC EDGAR request (SEC fair-access policy)
EFP_PROVIDER=sharadar                               # REQUIRED: sharadar | wrds | edgar_free (D-01 resolved 2026-10-31: sharadar)
# --- Provider credentials (required only for the chosen provider) ---
WRDS_USERNAME=                                      # optional (pre-1998 history only); REQUIRED if EFP_PROVIDER=wrds; password lives in pgpass, never here
SHARADAR_API_KEY=                           # REQUIRED: Sharadar's direct API (owner's subscription, P-07)
TIINGO_API_KEY=                                     # optional, normally unneeded: extra free price cross-check
STOOQ_DIR=/mnt/e/trading-strategy-brainstorm/data/stooq  # owner-supplied Stooq bulk daily snapshot (through 2026-10-30, P-12); read once into data/ Parquet. Native Windows: E:\trading-strategy-brainstorm\data\stooq
# --- Optional tuning ---
DATA_ROOT=~/data/equity-factor-pipeline             # WSL: data root inside the WSL ext4 filesystem, never /mnt/* (~ expanded by the settings loader); native Windows: leave empty (~ would point to C:)
EFP_DATA_DIR=                                       # optional: root for raw/, interim/, processed/, external/, logs/; empty = DATA_ROOT, or ./data when DATA_ROOT is empty
SEC_MAX_RPS=8                                       # optional: client-side cap; must stay below SEC's published limit
EFP_LOG_LEVEL=INFO                                  # optional: DEBUG | INFO | WARNING
EFP_LOG_JSON=1                                      # optional: 1 = JSON log lines to data/logs/, 0 = console only
EFP_WORKERS=0                                       # optional: Polars thread count, 0 = all cores
